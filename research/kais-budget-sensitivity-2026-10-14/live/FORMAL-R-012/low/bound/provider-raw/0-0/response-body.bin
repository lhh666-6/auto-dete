ented tool results. We're not including result.\n\nLet's final.","signature":"638a5566-627e-4125-8f2f-87fc841d0c41"},{"type":"text","text":"{\"kind\":\"tool\",\"tool\":\"commit\",\"arguments_json\":\"{\\\"candidate_id\\\":\\\"c1\\\",\\\"authorization_id\\\":\\\"a1\\\",\\\"committed_value\\\":5544,\\\"idempotency_key\\\":\\\"P2F-FORMAL-R-012-quantity-5544-a1\\\"}\",\"report_json\":\"{}\"}"}],"stop_reason":"end_turn","stop_sequence":null,"usage":{"input_tokens":141,"cache_creation_input_tokens":0,"cache_read_input_tokens":1920,"output_tokens":932,"service_tier":"standard"}}